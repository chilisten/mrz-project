# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/airbook

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Генерировать: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_replace_with_random_64_char_hex_string

# ─── AviationStack API ────────────────────────────────────────────────────────
# Бесплатная регистрация (без карты): https://aviationstack.com/signup/free
# 100 запросов/месяц бесплатно. Без ключа — работают демо-данные.
AVIATIONSTACK_API_KEY=your_api_key_here
AVIATIONSTACK_BASE_URL=http://api.aviationstack.com/v1
